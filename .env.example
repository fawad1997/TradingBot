# Copy this file to ".env" (same folder) and fill in your values. NEVER share .env.
# This template must contain PLACEHOLDERS ONLY - it is committed and shipped, unlike .env.

# ---- MetaTrader 5 / Exness ------------------------------------------------
# Login number, password and server exactly as shown in your Exness Personal Area / MT5.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Full path to terminal64.exe (optional if only one MT5 is installed)
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ---- PostgreSQL ------------------------------------------------------------
# Same password you set in database/00a_create_role.sql
# UPGRADING an existing install? Keep pointing at your current database - the rename is cosmetic:
#   DATABASE_URL=postgresql://asad_trader:YOUR_DB_PASSWORD@localhost:5432/asad_trading
# See database/03_rename_to_quantara.sql if you would rather rename it.
DATABASE_URL=postgresql://quantara_app:YOUR_DB_PASSWORD@localhost:5432/quantara

# ---- Dashboard ---------------------------------------------------------------
# Any long random text. You type it once in the browser to use controls (halt, resume, ...).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=

# ---- Alerts (optional; set "alerts": {"enabled": true, "channel": "..."} in config.json) ----
# channel "discord" -> a Discord channel webhook URL (Channel settings -> Integrations -> Webhooks)
# channel "ntfy"    -> https://ntfy.sh/<pick-something-long-and-unguessable>, install the ntfy app, subscribe
# channel "webhook" -> any endpoint that accepts a POST of {"text": "..."}
# TREAT AS A SECRET: anyone with this URL can read your alerts and post into your channel.
NOTIFY_URL=

# Optional: a separate webhook per kind of message, so a kill switch does not sit next to a routine fill.
# Any you leave empty fall back to NOTIFY_URL above, so filling in none behaves exactly as one channel did.
#   HEALTH   MetaTrader, database, connection - "is it alive"
#   RISK     refused orders, risk limits, emergency stops - things to act on
#   TRADES   fills and closures, the ordinary flow of the day
#   RESEARCH experiment results and promotion decisions
#   REVIEW   the daily summary
NOTIFY_URL_HEALTH=
NOTIFY_URL_RISK=
NOTIFY_URL_TRADES=
NOTIFY_URL_RESEARCH=
NOTIFY_URL_REVIEW=
# channel "email" (never blocked; Gmail needs an app password, not your login password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=

# ---- REAL money safety lock --------------------------------------------------
# Leave EMPTY. Only for environment "REAL", set exactly: I_ACCEPT_REAL_MONEY_RISK
QUANTARA_CONFIRM_REAL=
